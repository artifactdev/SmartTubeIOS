// Shared settings for all targets. Secrets are optional so forks/CI build without them.
SMARTTUBE_TEAM_ID = CJKNBR45T2
SMARTTUBE_TV_TEAM_ID = $(SMARTTUBE_TEAM_ID)
SMARTTUBE_BUNDLE_PREFIX = com.art-ifact
SMARTTUBE_BUNDLE_BASE = $(SMARTTUBE_BUNDLE_PREFIX).smarttube
SMARTTUBE_APP_GROUP_ID = group.$(SMARTTUBE_BUNDLE_BASE)
SMARTTUBE_UBIQUITY_KVSTORE_ID = $(TeamIdentifierPrefix)$(SMARTTUBE_BUNDLE_BASE)

#include? "Secrets.xcconfig"
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0
TVOS_DEPLOYMENT_TARGET = 17.0
MARKETING_VERSION = 5.1
CURRENT_PROJECT_VERSION = 3
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEVELOPMENT_TEAM = $(SMARTTUBE_TEAM_ID)
DEVELOPMENT_TEAM[sdk=appletvos*] = $(SMARTTUBE_TV_TEAM_ID)
